# Samba share for adding media by hand: drop files into inbox/movies or
# inbox/tv from Finder (smb://<host>.local/inbox) and Plex shows them; both
# folders are part of the Plex libraries (/data/inbox). bin/setup renders
# this file to /etc/samba/smb.conf with LAN_BIND_ADDRESS from media/.env, so
# the share answers on the home LAN only, never on the tailnet or IPv6.
# No password: anyone on the home LAN can add and delete files in the inbox.
[global]
   server string = %h
   interfaces = 127.0.0.1 LAN_BIND_ADDRESS
   bind interfaces only = yes
   disable netbios = yes
   smb ports = 445
   map to guest = bad user
   server min protocol = SMB3
   # Finder metadata in streams instead of ._ files
   vfs objects = fruit streams_xattr
   fruit:metadata = stream
   fruit:model = MacSamba
   fruit:veto_appledouble = no
   fruit:wipe_intentionally_left_blank_rfork = yes
   fruit:delete_empty_adfiles = yes
   load printers = no
   printing = bsd
   printcap name = /dev/null

[inbox]
   path = MEDIA_VOLUME/inbox
   guest ok = yes
   guest only = yes
   # Files belong to the media user (PUID), like the downloads
   force user = SMB_USER
   read only = no
