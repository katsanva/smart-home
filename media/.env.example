# Media stack settings. Copy to `media/.env`; values here override common.env.
# This file is safe to publish; keep real tokens only in `media/.env`.

# Absolute path of the verified media disk mount
MEDIA_VOLUME=/srv/media

# Optional one-time token from https://plex.tv/claim for first Plex setup
PLEX_CLAIM=

# Optional services, comma-separated: extras (Trailarr, Maintainerr, Agregarr,
# Tautulli, Audiobookshelf), ukr-torznab (needs the Toloka login below)
COMPOSE_PROFILES=

# Address for web UI ports used by the host scripts (bin/setup, bin/space-guard).
# Keep 127.0.0.1: the gated web UIs have their own logins off.
# Plex uses host networking regardless.
MEDIA_BIND_ADDRESS=127.0.0.1

# ProtonVPN for qBittorrent (needs a plan with port forwarding). In
# https://account.proton.me/u/0/vpn/WireGuard create a configuration with
# "NAT-PMP (Port Forwarding)" on and copy its PrivateKey here. Countries are
# comma-separated; only port-forwarding (P2P) servers are used.
PROTONVPN_WIREGUARD_PRIVATE_KEY=
PROTONVPN_SERVER_COUNTRIES=Switzerland,Spain,Czech Republic,Ukraine,Romania,Bulgaria,Latvia
# Key for gluetun's control server routes other than the ones Homepage reads
# (media/gluetun/auth.toml); bin/setup generates it
GLUETUN_API_KEY=

# The Pi's LAN IP (reserve it in the router's DHCP): Caddy (ports 80 and 443)
# and TorrServer listen here, so the home network reaches them and the tailnet
# does not. Empty keeps them local only (127.0.0.2 is an unused loopback
# address). The address must exist when the stack starts, or they fail to start.
LAN_BIND_ADDRESS=

# HTTPS names for the web UIs: https://<name>.HOME_DOMAIN (media/Caddyfile).
# Point HOME_DOMAIN and *.HOME_DOMAIN to LAN_BIND_ADDRESS in DNS (DNS only, not
# proxied). CLOUDFLARE_API_TOKEN needs only Zone → DNS → Edit on that zone: Caddy
# uses it for Let's Encrypt DNS challenges. Empty: *.localhost, local certificates.
HOME_DOMAIN=
CLOUDFLARE_API_TOKEN=

# Pocket ID (https://id.HOME_DOMAIN) and its tinyauth client. bin/setup
# generates the encryption key; create the client in Pocket ID with the callback
# URL https://auth.HOME_DOMAIN/api/oauth/callback/pocketid and copy its ID and
# secret here.
POCKET_ID_ENCRYPTION_KEY=
POCKET_ID_CLIENT_ID=
POCKET_ID_CLIENT_SECRET=

# bin/space-guard: pauses grabs and downloads below SPACE_GUARD_MIN_FREE percent
# free and resumes at SPACE_GUARD_RESUME_FREE. Credentials of the apps it pauses;
# API keys are under Settings → General in Sonarr and Radarr.
SPACE_GUARD_MIN_FREE=10
SPACE_GUARD_RESUME_FREE=12
QBITTORRENT_USER=
QBITTORRENT_PASSWORD=
SONARR_API_KEY=
RADARR_API_KEY=

# Homepage widgets (http://home.local). bin/setup fills PROWLARR_API_KEY; copy
# the others from Bazarr (Settings → General), Seerr (Settings → General) and
# Plex (PlexOnlineToken in Preferences.xml). Empty keys only blank that widget.
PROWLARR_API_KEY=
BAZARR_API_KEY=
SEERR_API_KEY=
PLEX_TOKEN=

# ukr-torznab (Toloka, UTOPIA and 0day indexer for Prowlarr): toloka.to login,
# the utp.to API key for /utp and the 0day.community login for /0day (empty
# turns those off)
TOLOKA_USERNAME=
TOLOKA_PASSWORD=
UTP_API_KEY=
ZERODAY_USERNAME=
ZERODAY_PASSWORD=
