# Settings for bin/backup. Copy to `backup.env` (never commit it) and restrict it:
#   chmod 600 backup.env
# The file is sourced by bash, so quote values containing spaces.

# age public key ("age1...") of the recovery key. The private key lives only in
# the password manager, never on the Pi or in Telegram.
BACKUP_RECIPIENT=age1replace-with-recovery-public-key

# Bot token from @BotFather and the private chat that receives snapshots
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Staging for the latest undelivered snapshot. Keep it on the media disk,
# outside DOCKER (appdata), so it is never archived into the next snapshot.
BACKUP_STAGING=/srv/media/backup-staging

# Space-separated stacks briefly stopped for a consistent snapshot. Defaults to
# SMART_HOME_STACKS; every stack keeping data under DOCKER must be listed.
#BACKUP_STOP_STACKS=media
