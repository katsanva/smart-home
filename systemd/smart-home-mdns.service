# Publishes <name>.local for the media web UIs on the LAN (bin/mdns-aliases)

[Unit]
Description=Smart Home mDNS names for the media web UIs
Requires=avahi-daemon.service
After=avahi-daemon.service

[Service]
Environment=SMART_HOME_DIR=@SMART_HOME_DIR@
ExecStart=@SMART_HOME_DIR@/bin/mdns-aliases
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
